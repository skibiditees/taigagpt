# Never commit your real keys. Set these in your hosting provider's environment/secrets panel.
DISCORD_BOT_TOKEN=put_your_discord_bot_token_here
GEMINI_API_KEY=put_your_google_ai_studio_key_here
GEMINI_MODEL=gemini-3.8-flash

# Ambient messages are intentionally rare. Set to 0 to disable unprompted replies.
TAIGA_AMBIENT_CHANCE=0.008
TAIGA_CHANNEL_COOLDOWN=55
TAIGA_USER_COOLDOWN=18
TAIGA_CONTEXT_MESSAGES=12
TAIGA_DB_PATH=taiga_memory.sqlite3
BOT_PREFIX=!
